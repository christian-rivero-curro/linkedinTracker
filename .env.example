# =============================================================================
# linkedinTracker - Configuración de Variables de Entorno (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Base de datos & Autenticación (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------
# URL de conexión al pooler de Supabase (modo Transaction o Session)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Clave secreta para firmar las cookies de sesión (genera una cadena aleatoria segura)
APP_SECRET_KEY=your_random_secret_key_change_in_production

# Límite máximo de usuarios permitidos en el registro de la app
MAX_USERS=2

# Host y puerto para ejecutar el servidor FastAPI localmente
HOST=127.0.0.1
PORT=8000


# -----------------------------------------------------------------------------
# 2. Modelos LLM & OpenRouter
# -----------------------------------------------------------------------------
# API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_key

# Modelo para extracción de habilidades y experiencia del CV en /onboarding
OPENROUTER_MODEL_EXTRACTION=inclusionai/ling-3.0-flash-fin:free

# Modelo para evaluar cualitativamente cada oferta de empleo
OPENROUTER_MODEL_SCORING=inclusionai/ling-3.0-flash-fin:free

# Opcional: Prompt personalizado para la evaluación LLM (si está vacío, usa pipeline/prompts/evaluate_job.txt)
# LLM_EVALUATION_PROMPT="Tu prompt personalizado con {profile_json}, {job_title}, etc."


# -----------------------------------------------------------------------------
# 3. Embeddings Locales (sentence-transformers)
# -----------------------------------------------------------------------------
# Modelo de embeddings de 384 dimensiones ejecutado en el runner de GitHub Actions
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# -----------------------------------------------------------------------------
# 4. Scraper de LinkedIn (Guest Scraper & Playwright)
# -----------------------------------------------------------------------------
# Ventana de tiempo hacia atrás para filtrar ofertas en LinkedIn (en horas)
LINKEDIN_HOURS_AGO=4

# Número máximo de ofertas a extraer por cada variante de búsqueda activa
LINKEDIN_MAX_JOBS_PER_VARIANT=25

# Opciones para el scraper con sesión autenticada / Playwright (si aplica)
LINKEDIN_HEADLESS=true
LINKEDIN_STORAGE_STATE=linkedin_session/storage_state.json
LINKEDIN_DIAGNOSTICS_DIR=linkedin_diagnostics


# -----------------------------------------------------------------------------
# 5. Control de Antigüedad y Presupuesto LLM
# -----------------------------------------------------------------------------
# Descartar ofertas con más de X días de antigüedad
MAX_JOB_AGE_DAYS=35


# Presupuesto máximo de llamadas diarias a OpenRouter
LLM_DAILY_BUDGET=48

# Máximo de ofertas evaluadas con LLM por cada ejecución del workflow
LLM_MAX_CALLS_PER_RUN=50

# Pausa entre llamadas al LLM (en segundos) para evitar bloqueos por rate limit (429)
LLM_CALL_DELAY_SECONDS=2.0

# Número de errores consecutivos antes de activar el circuit breaker y abortar la ejecución
LLM_MAX_CONSECUTIVE_ERRORS=3

# Opcional: ID de usuario específico a procesar en workflows/scripts (dejar vacío para todos)
TARGET_USER_ID=
